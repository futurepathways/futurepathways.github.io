---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string; // page title; the site name is added automatically
  description?: string;
  /** Absolute or site-relative path to the preview image (PRD 6.8). */
  image?: string;
  /** Set true on pages that search engines must not list (PRD 5.4). */
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Use this exact text as the page title instead of "Title | Future Pathways" (the home page). */
  fullTitle?: string;
  /** Structured data (schema.org JSON-LD) for this page: one object or a list. */
  schema?: object | object[];
}

const {
  title,
  description = site.tagline,
  image = '/images/preview-default.png',
  noindex = false,
  type = 'website',
  schema,
} = Astro.props;

const fullTitle = Astro.props.fullTitle ?? (title === site.name ? site.name : `${title} | ${site.name}`);
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// '<' is escaped so text inside the JSON can never close the script tag.
const jsonLd = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050912" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        d.classList.add('js');
        try { t = localStorage.getItem('fp-theme'); } catch (e) {}
        d.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
      })();
    </script>

    <!-- Link previews (PRD 6.8) -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
    {schemas.map((o) => <script type="application/ld+json" set:html={jsonLd(o)} />)}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/bookmarks';
    </script>
    {
      site.goatCounterCode && (
        <script
          is:inline
          data-goatcounter={`https://${site.goatCounterCode}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
