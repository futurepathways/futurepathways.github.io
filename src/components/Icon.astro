---
// Simple, consistent line icons (PRD 12: one icon per category, plus UI icons).
// Usage: <Icon name="careers" size={28} />
interface Props {
  name:
    | 'careers'
    | 'opportunities'
    | 'courses'
    | 'countries'
    | 'universities'
    | 'search'
    | 'bookmark'
    | 'bookmark-filled'
    | 'menu'
    | 'close'
    | 'arrow'
    | 'calendar'
    | 'parents'
    | 'tag'
    | 'mail';
  size?: number;
  class?: string;
  label?: string; // if given, the icon is announced to screen readers
}
const { name, size = 24, class: className = '', label } = Astro.props;

const paths: Record<Props['name'], string> = {
  careers:
    '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>',
  opportunities:
    '<path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.2l5.9-.9z"/>',
  courses:
    '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5V5.5"/><path d="M8 7h8"/><path d="M8 11h6"/>',
  countries:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/>',
  universities:
    '<path d="M3 10 12 5l9 5-9 5z"/><path d="M7 12.5V17c0 1 2.5 2 5 2s5-1 5-2v-4.5"/><path d="M21 10v5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  bookmark: '<path d="M6 3h12v18l-6-4-6 4z"/>',
  'bookmark-filled': '<path d="M6 3h12v18l-6-4-6 4z" fill="currentColor"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  parents:
    '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.2"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M14.5 20a4 4 0 0 1 7 0"/>',
  tag: '<path d="M3 12V4h8l9 9-8 8z"/><circle cx="7.5" cy="8.5" r="1.2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`icon ${className}`.trim()}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: 0 0 auto;
    display: inline-block;
    vertical-align: middle;
  }
</style>
