---
// One post card (PRD 6.2): title, summary, grade band, tags, reading time, deadline badge.
// Every tag and category on the card is a link. Data attributes feed the listing filters.
import type { Post } from '../lib/content';
import { gradeBandLabel, toDateString } from '../lib/content';
import { categoryByKey } from '../config/site';
import TagChips from './TagChips.astro';
import DeadlineBadge from './DeadlineBadge.astro';
import Icon from './Icon.astro';
import { deadlineStatus, formatDateString } from '../lib/deadlines';
import { nextDateOf } from '../lib/content';

interface Props {
  post: Post;
  /** The category whose listing this card sits in, for the "Also in …" label. */
  context?: string;
  headingLevel?: 'h2' | 'h3';
}
const { post, context, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const main = categoryByKey[post.category];
const alsoIn = context && context !== post.category && post.extraCategories.includes(context as any) ? categoryByKey[context as keyof typeof categoryByKey] : null;
const nextDate = nextDateOf(post);
const status = post.opportunity ? deadlineStatus(post.opportunity.deadline, post.opportunity.rolling) : nextDate ? deadlineStatus(nextDate, false) : null;
---

<li
  class={`card post-card cat-${post.category}`}
  data-card
  data-slug={post.slug}
  data-title={post.title.toLowerCase()}
  data-date={toDateString(post.publishedDate)}
  data-cat={[post.category, ...post.extraCategories].join(' ')}
  data-grade={post.gradeBands.join(' ')}
  data-stream={post.streams.join(' ')}
  data-country={post.countries.join(' ')}
  data-tags={post.tags.map((t) => t.slug).join(' ')}
  data-search-words={[main.name, ...post.extraCategories.map((c) => categoryByKey[c].name), ...post.tags.flatMap((t) => [t.name, ...t.search])].join(' ').toLowerCase()}
  data-type={post.opportunity?.type}
  data-mode={post.opportunity?.mode}
  data-cost={post.opportunity?.cost}
  data-deadline-date={nextDate ?? undefined}
  data-status={status ?? undefined}
>
  <div class="post-card-top">
    <a class="cat-chip" href={main.path}>
      <Icon name={post.category} size={16} />
      {main.shortName}
    </a>
    {alsoIn && <span class="also-in">Also in {alsoIn.shortName}</span>}
    {post.status === 'draft' && <span class="badge badge--closed">Draft</span>}
    {
      post.opportunity ? (
        <span class="post-card-deadline">
          <DeadlineBadge deadline={post.opportunity.deadline} rolling={post.opportunity.rolling} />
        </span>
      ) : (
        nextDate && (
          <span class="post-card-deadline" title={post.keyDates.find((k) => k.date === nextDate)?.label}>
            <DeadlineBadge deadline={nextDate} rolling={false} />
            <span class="post-card-nextdate">{formatDateString(nextDate)}</span>
          </span>
        )
      )
    }
  </div>

  <Heading class="post-card-title">
    <a href={post.path}>{post.title}</a>
  </Heading>
  <p class="post-card-summary">{post.summary}</p>

  <div class="post-card-meta">
    <span>{post.gradeBands.map((g) => gradeBandLabel[g]).join(' · ')}</span>
    <span aria-hidden="true">·</span>
    <span>{post.readingMinutes} min read</span>
    <span aria-hidden="true">·</span>
    <time datetime={toDateString(post.publishedDate)}>{formatDateString(toDateString(post.publishedDate))}</time>
    <button
      type="button"
      class="save-btn js-only"
      data-save={post.slug}
      data-save-title={post.title}
      aria-pressed="false"
      aria-label={`Save "${post.title}"`}
    >
      <Icon name="bookmark" size={18} class="save-icon-empty" />
      <Icon name="bookmark-filled" size={18} class="save-icon-filled" />
      <span data-save-label>Save</span>
    </button>
  </div>

  <TagChips tags={post.tags} limit={5} size="small" />
</li>

