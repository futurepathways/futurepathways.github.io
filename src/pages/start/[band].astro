---
// Start here by grade (PRD 6.10): intro, curated "read these first", then every other post for the band.
import { load as loadYaml } from 'js-yaml';
import startRaw from '../../data/start.yml?raw';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import PostList from '../../components/PostList.astro';
import { getVisiblePosts, byNewest } from '../../lib/content';
import { gradeBands } from '../../config/site';

interface Band {
  key: string;
  title: string;
  intro: string;
  read_first: string[];
}
const bands = (loadYaml(startRaw) as { bands: Band[] }).bands;

export async function getStaticPaths() {
  return gradeBands.map((g) => ({ params: { band: g.path.split('/')[2] }, props: { key: g.key } }));
}

const { key } = Astro.props as { key: string };
const band = bands.find((b) => b.key === key) ?? { key, title: key, intro: '', read_first: [] };
const all = (await getVisiblePosts()).filter((p) => p.gradeBands.includes(key));
const first = band.read_first.map((slug) => all.find((p) => p.slug === slug)).filter(Boolean).slice(0, 6) as typeof all;
const rest = all.filter((p) => !first.includes(p)).sort(byNewest);
---

<Base title={`Start here: ${band.title}`} description={band.intro.slice(0, 155)}>
  <section class="page-hero band-hero">
    <div class="container">
      <p class="kicker">Start here</p>
      <h1>{band.title}</h1>
      <p class="page-hero-lead band-intro">{band.intro}</p>
      <p class="band-switch">
        Not your grade?
        {
          gradeBands
            .filter((g) => g.key !== key)
            .map((g) => (
              <a href={g.path}>{g.label}</a>
            ))
        }
      </p>
    </div>
  </section>

  <div class="container section">
    {
      key !== '6-8' && (
        <a class="tool-callout" href="/roadmaps/">
          <strong>Choosing subjects?</strong> The Career Roadmaps tool maps 26 roles to the subjects to keep, the
          degrees and the entrance exams.
          <Icon name="arrow" size={20} />
        </a>
      )
    }
    {
      first.length > 0 && (
        <section>
          <h2>Read these first</h2>
          <ul class="grid grid--2 first-grid">
            {first.map((p) => (
              <PostCard post={p} headingLevel="h3" />
            ))}
          </ul>
        </section>
      )
    }
    <section>
      <h2>{first.length ? 'More for your grade' : 'Posts for your grade'}</h2>
      <PostList posts={rest} showCategoryFilter headingLevel="h3" emptyMessage="No more posts for this grade yet." />
    </section>
  </div>
</Base>

<script>
  import '../../scripts/deadlines';
</script>

<style>
  .band-switch {
    margin: 0;
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .band-switch {
    margin-top: 1rem !important;
    font-family: var(--font-mono);
    font-size: 0.8rem !important;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .band-switch a {
    color: var(--link);
  }
  .first-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  h2 {
    margin-top: 1.2rem;
  }
  .tool-callout {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 5px solid var(--gold);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
  }
  .tool-callout :global(.icon) {
    margin-left: auto;
    color: var(--link);
  }
  .band-hero {
    --cat: var(--violet);
  }
</style>
