---
// Post page (PRD 6.3). Sections appear in the order the PRD gives.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import TagChips from '../../components/TagChips.astro';
import DeadlineBadge from '../../components/DeadlineBadge.astro';
import PostCard from '../../components/PostCard.astro';
import GlanceCard from '../../components/GlanceCard.astro';
import { site, categoryByKey } from '../../config/site';
import {
  getVisiblePosts,
  relatedPosts,
  formatDate,
  gradeBandLabel,
  streamLabel,
  opportunityTypeLabel,
  monthsSince,
  nextDateOf,
  glanceCambridgeLabel,
  type Post,
} from '../../lib/content';
import { countryBySlug } from '../../lib/data';
import { formatDateString } from '../../lib/deadlines';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { category: post.category, slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const all = await getVisiblePosts();
const related = relatedPosts(post, all, 3);
const main = categoryByKey[post.category];
const extras = post.extraCategories.map((k) => categoryByKey[k]);
const opp = post.opportunity;
const outOfDate = monthsSince(post.lastChecked) >= 6;
const previewImage = post.coverImage ? post.coverImage.src : `/images/preview-${post.category}.png`;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((h) => h.depth === 2).slice(0, 14);
// Layered posts: sections fold into <details> (src/lib/rehype-sections.mjs); same rule here for the toolbar.
const fold = (post.entry.data as any).fold as boolean | undefined;
const layered =
  fold !== false &&
  ((post.category === 'universities' && !!post.glance) ||
    ((fold === true || post.category === 'courses' || post.category === 'countries') &&
      headings.filter((h) => h.depth === 2).length >= 5));
const modeLabel: Record<string, string> = { online: 'Online', 'in-person': 'In person', hybrid: 'Online and in person' };

// "Last updated" (16 Nov 2026): the date the facts were last checked, never earlier than publication.
const updated = post.lastChecked > post.publishedDate ? post.lastChecked : post.publishedDate;
const iso = (d: Date) => d.toISOString().slice(0, 10);

// Questions families ask: the post's own `faq`, plus, for university profiles, four questions
// built from the quick facts card, so the answers always match the card.
// "University Spotlight: CHRIST (Deemed to be University), Bengaluru" -> "CHRIST (Deemed to be University)"
const uniName = post.title.replace(/^University Spotlight:\s*/i, '').replace(/,\s*[^,()]+$/, '');
const camAnswer: Record<string, string> = { yes: 'Yes.', 'with-conditions': 'Yes, with conditions.', check: 'Possibly: check with the university.' };
const autoFaq: { q: string; a: string }[] = [];
if (post.category === 'universities' && post.glance) {
  const g = post.glance;
  const next = nextDateOf(post);
  const nextItem = next ? post.keyDates.find((k) => k.date === next) : undefined;
  autoFaq.push(
    { q: `Can a Cambridge A Level student apply to ${uniName}?`, a: `${camAnswer[g.cambridge] ?? glanceCambridgeLabel[g.cambridge]} ${g.cambridge_note}` },
    { q: `How do you get into ${uniName}?`, a: g.entry },
    { q: `How much does ${uniName} cost a year?`, a: `${g.cost}. Fees change every year, so check the official fee page before you plan.` },
    {
      q: `When is the next date for ${uniName}?`,
      a: nextItem
        ? `${formatDateString(nextItem.date)}: ${nextItem.label}.${nextItem.note ? ' ' + nextItem.note.replace(/\.$/, '') + '.' : ''} Dates can change, so confirm on the official site.`
        : `No date for the next admission cycle had been announced when this profile was last checked on ${formatDate(post.lastChecked)}. Watch the official site.`,
    },
  );
}
const faq = [...autoFaq, ...post.faq];

// Structured data: the guide as an Article, its breadcrumb trail, and its questions.
const pageUrl = new URL(post.path, Astro.site).href;
const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title.length > 110 ? post.title.slice(0, 107) + '...' : post.title,
    description: post.summary,
    image: new URL(previewImage, Astro.site).href,
    datePublished: iso(post.publishedDate),
    dateModified: iso(updated),
    inLanguage: 'en-IN',
    mainEntityOfPage: pageUrl,
    author: { '@type': 'Person', name: post.author || site.ownerName, url: site.ownerSite },
    publisher: { '@type': 'Person', name: site.ownerName, url: site.ownerSite },
    isPartOf: { '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: main.name, item: new URL(main.path, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
    ],
  },
];
if (faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<Base title={post.title} description={post.summary} image={previewImage} type="article" schema={schema}>
  {post.status === 'draft' && <p class="draft-banner">Draft. This post is not on the live site yet.</p>}

  <article class={`post cat-${post.category}`} data-pagefind-body data-pagefind-meta={`slug:${post.slug}`} data-post-slug={post.slug}>
    <header class="post-header page-hero">
      <div class="container post-header-inner">
        <p class="post-cats">
          <a class="cat-chip" href={main.path} data-pagefind-filter="category"><Icon name={post.category} size={18} /> {main.name}</a>
          {
            extras.map((c) => (
              <a class="cat-chip cat-chip--extra" href={c.path} data-pagefind-filter="category">
                Also in {c.name}
              </a>
            ))
          }
        </p>
        <h1 data-pagefind-meta="title" data-pagefind-weight="10">{post.title}</h1>
        <p class="post-summary" data-pagefind-meta="summary" data-pagefind-weight="5">{post.summary}</p>

        <dl class="post-facts">
          <div>
            <dt>For</dt>
            <dd>{post.gradeBands.map((g) => gradeBandLabel[g]).join(', ')}</dd>
          </div>
          {
            post.streams.length > 0 && (
              <div>
                <dt>Stream</dt>
                <dd>{post.streams.map((s) => streamLabel[s]).join(', ')}</dd>
              </div>
            )
          }
          {
            post.countries.length > 0 && (
              <div>
                <dt>Country</dt>
                <dd>{post.countries.map((c) => countryBySlug[c].name).join(', ')}</dd>
              </div>
            )
          }
          <div>
            <dt>Reading time</dt>
            <dd>{post.readingMinutes} min</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={post.publishedDate.toISOString().slice(0, 10)}>{formatDate(post.publishedDate)}</time>
            </dd>
          </div>
          <div>
            <dt>Last updated</dt>
            <dd>
              <time datetime={iso(updated)}>{formatDate(updated)}</time>
            </dd>
          </div>
          {
            post.author && (
              <div>
                <dt>Written by</dt>
                <dd>{post.author}</dd>
              </div>
            )
          }
        </dl>

        <div class="post-tags" data-pagefind-weight="8">
          <TagChips tags={post.tags} grouped />
        </div>
        <div hidden>
          {/* Search words: tag names, search words and category names, indexed but not shown (PRD 8). */}
          <span data-pagefind-weight="8">
            {
              [
                main.name,
                ...extras.map((c) => c.name),
                ...post.tags.flatMap((t) => [t.name, ...t.search]),
                ...post.countries.flatMap((c) => [countryBySlug[c].name, ...countryBySlug[c].search]),
              ].join(', ')
            }
          </span>
        </div>
      </div>
    </header>

    <div class="container post-layout">
      <div class="post-main">
        {post.glance && post.category === 'universities' && <GlanceCard post={post} />}

        {
          post.coverImage ? (
            <figure class="post-cover">
              <Image
                src={post.coverImage}
                alt={post.coverAlt}
                widths={[480, 800, 1200]}
                sizes="(max-width: 800px) 100vw, 800px"
                loading="eager"
              />
            </figure>
          ) : (
            <figure class="post-cover">
              <img src={`/images/preview-${post.category}.png`} alt="" width="1200" height="630" loading="eager" />
            </figure>
          )
        }

        {
          opp && (
            <aside class="deadline-box" aria-labelledby="deadline-heading">
              <h2 id="deadline-heading">
                <Icon name="calendar" size={22} /> {opportunityTypeLabel[opp.type] ?? 'Opportunity'}
              </h2>
              <dl class="deadline-facts">
                <div>
                  <dt>Deadline</dt>
                  <dd>
                    {opp.rolling ? (
                      <DeadlineBadge deadline={null} rolling={true} />
                    ) : opp.deadline ? (
                      <DeadlineBadge deadline={opp.deadline} rolling={false} showDate />
                    ) : (
                      'Not announced yet'
                    )}
                    {opp.rolling && <span class="rolling-note"> No fixed deadline. Apply any time.</span>}
                  </dd>
                </div>
                {opp.deadlineNote && (
                  <div>
                    <dt>Note</dt>
                    <dd>{opp.deadlineNote}</dd>
                  </div>
                )}
                {opp.eventDates && (
                  <div>
                    <dt>When</dt>
                    <dd>{opp.eventDates}</dd>
                  </div>
                )}
                {opp.mode && (
                  <div>
                    <dt>Mode</dt>
                    <dd>{modeLabel[opp.mode] ?? opp.mode}</dd>
                  </div>
                )}
                {opp.cost && (
                  <div>
                    <dt>Cost</dt>
                    <dd>{opp.cost === 'free' ? 'Free' : 'Paid'}</dd>
                  </div>
                )}
              </dl>
              <div class="deadline-actions">
                {opp.applyLink && (
                  <a class="btn btn--gold" href={opp.applyLink} target="_blank" rel="noopener">
                    Apply on the official site
                  </a>
                )}
                {opp.deadline && !opp.rolling && (
                  <a class="btn btn--outline" href={`${post.path}deadline.ics`} download>
                    <Icon name="calendar" size={18} /> Add to calendar
                  </a>
                )}
              </div>
            </aside>
          )
        }

        {
          post.keyDates.length > 0 && (
            <aside class="keydates-box" aria-labelledby="keydates-heading">
              <h2 id="keydates-heading">
                <Icon name="calendar" size={22} /> Key dates
              </h2>
              <ul class="keydates-list">
                {post.keyDates.map((k) => (
                  <li>
                    <span class="keydates-date">{formatDateString(k.date)}</span>
                    <span class="keydates-text">
                      <span class="keydates-label">{k.url ? <a href={k.url} target="_blank" rel="noopener">{k.label}</a> : k.label}</span>
                      {k.note && <span class="keydates-note">{k.note}</span>}
                    </span>
                    <DeadlineBadge deadline={k.date} rolling={false} />
                  </li>
                ))}
              </ul>
              <p class="keydates-foot">
                Dates are for the cycle named in the post and can change. Check the official page before you plan.
                See every date on the site on the <a href="/deadlines/">Upcoming Deadlines</a> page.
              </p>
            </aside>
          )
        }

        <aside class="parents-box" aria-labelledby="parents-heading">
          <h2 id="parents-heading"><Icon name="parents" size={22} /> For Parents</h2>
          <p>{post.parentSummary}</p>
        </aside>

        {
          toc.length >= 4 && (
            <nav class="toc" aria-label="On this page">
              <p class="toc-title">On this page</p>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
                {post.officialLinks.length > 0 && (
                  <li>
                    <a href="#official-links">Official links</a>
                  </li>
                )}
              </ul>
            </nav>
          )
        }

        {
          outOfDate && (
            <p class="note">
              <strong>May be out of date.</strong> This post was last checked on {formatDate(post.lastChecked)}. Please
              confirm details on the official links.
            </p>
          )
        }

        {
          layered && (
            <p class="sec-toolbar js-only" data-pagefind-ignore>
              <span>Tap a heading to open that section.</span>
              <button type="button" class="btn btn--outline btn--small" data-expand-all>Open all</button>
              <button type="button" class="btn btn--outline btn--small" data-collapse-all>Close all</button>
            </p>
          )
        }

        <div class="post-body prose">
          <Content />
        </div>

        {
          faq.length > 0 && (
            <section class="faq" id="questions" aria-labelledby="faq-heading">
              <h2 id="faq-heading">Questions families ask</h2>
              <dl>
                {faq.map((f) => (
                  <div class="faq-item">
                    <dt>{f.q}</dt>
                    <dd>{f.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <p class="checked-line" data-pagefind-ignore>
          {
            post.reviewedBy ? (
              <>
                <strong>Checked by {post.reviewedBy}</strong> on {formatDate(post.lastChecked)}.
              </>
            ) : (
              <>
                <strong>Last checked</strong> {formatDate(post.lastChecked)}.
              </>
            )
          }{' '}
          Fees, dates and rules change. Always check the official link before applying.
        </p>

        {
          post.officialLinks.length > 0 && (
            <section class="official-links" id="official-links" data-pagefind-ignore>
              <h2>Official links</h2>
              <ul>
                {post.officialLinks.map((l) => (
                  <li>
                    <a href={l.url} target="_blank" rel="noopener">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="post-actions js-only" data-pagefind-ignore>
          <button
            type="button"
            class="btn btn--outline"
            data-save={post.slug}
            data-save-title={post.title}
            aria-pressed="false"
          >
            <Icon name="bookmark" size={18} class="save-icon-empty" />
            <Icon name="bookmark-filled" size={18} class="save-icon-filled" />
            <span data-save-label>Save</span>
          </button>
          <button type="button" class="btn btn--outline" data-copy-link>Copy link</button>
          <a
            class="btn btn--outline"
            href={`https://wa.me/?text=${encodeURIComponent(`${post.title} - ${new URL(post.path, Astro.site)}`)}`}
            target="_blank"
            rel="noopener"
          >
            Share on WhatsApp
          </a>
        </div>

        {
          related.length > 0 && (
            <section class="related" data-pagefind-ignore>
              <h2>You may also like</h2>
              <ul class="grid grid--3 related-grid">
                {related.map((p) => (
                  <PostCard post={p} />
                ))}
              </ul>
            </section>
          )
        }

        <p class="counsellor-note" data-pagefind-ignore>
          <strong>Talk to a career counsellor.</strong> A good counsellor can help you work out what this means for you.
          You can also write to me at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> or use my
          <a href={site.contactUrl}>contact page</a>.
        </p>

        {post.imageCredit && <p class="image-credit" data-pagefind-ignore>{post.imageCredit}</p>}
      </div>
    </div>
  </article>
</Base>

<script>
  import '../../scripts/deadlines';
  // Every external link in the post body opens in a new tab.
  document.querySelectorAll<HTMLAnchorElement>('.post-body a[href^="http"]').forEach((a) => {
    if (a.hostname !== location.hostname) {
      a.target = '_blank';
      a.rel = 'noopener';
    }
  });
  // Layered sections: open the one a link points to, open/close all, and print everything.
  const secs = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('.post-body details.sec'));
  function openFor(hash: string) {
    if (!hash || hash.length < 2) return;
    const el = document.getElementById(decodeURIComponent(hash.slice(1)));
    const d = el?.closest('details');
    if (d && !d.open) d.open = true;
    if (d) el!.scrollIntoView();
  }
  openFor(location.hash);
  window.addEventListener('hashchange', () => openFor(location.hash));
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => setTimeout(() => openFor(a.getAttribute('href') || ''), 0)),
  );
  document.querySelectorAll('[data-expand-all]').forEach((b) => b.addEventListener('click', () => secs().forEach((d) => (d.open = true))));
  document.querySelectorAll('[data-collapse-all]').forEach((b) => b.addEventListener('click', () => secs().forEach((d) => (d.open = false))));
  let printed: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    printed = secs().filter((d) => !d.open);
    printed.forEach((d) => (d.open = true));
  });
  window.addEventListener('afterprint', () => printed.forEach((d) => (d.open = false)));

  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      btn.textContent = 'Link copied';
      setTimeout(() => (btn.textContent = 'Copy link'), 2000);
    } catch {
      prompt('Copy this link:', location.href);
    }
  });
</script>

<style>
  .post-header {
    padding-block: 2.4rem 1.8rem;
  }
  .post-header-inner {
    max-width: 860px;
  }
  .post-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0 0 0.4rem;
  }
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--cat);
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.85rem;
  }
  .cat-chip--extra {
    color: var(--text-muted);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
  }
  .cat-chip:hover {
    text-decoration: underline;
  }
  .post-summary {
    font-size: 1.14rem;
    color: var(--text-muted);
    max-width: 62ch;
  }
  .post-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }
  .post-facts div {
    display: flex;
    gap: 0.4rem;
  }
  .post-facts dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    align-self: center;
  }
  .post-facts dd {
    margin: 0;
    font-weight: 600;
  }
  .post-tags {
    margin-top: 0.6rem;
  }

  .post-layout {
    padding-block: 1.5rem;
  }
  .post-main {
    max-width: 800px;
  }
  .post-cover {
    margin: 0 0 1.5rem;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .post-cover img {
    width: 100%;
    height: auto;
  }

  .keydates-box {
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    margin-bottom: 1.4rem;
    background: var(--surface);
  }
  .keydates-box h2 {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .keydates-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .keydates-list li {
    display: grid;
    grid-template-columns: 7.5em 1fr auto;
    gap: 0.4rem 0.8rem;
    align-items: start;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .keydates-list li:last-child {
    border-bottom: 0;
  }
  .keydates-date {
    font-weight: 700;
    color: var(--heading);
  }
  .keydates-text {
    display: flex;
    flex-direction: column;
  }
  .keydates-note {
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .keydates-foot {
    margin: 0.8rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  @media (max-width: 480px) {
    .keydates-list li {
      grid-template-columns: 1fr auto;
    }
    .keydates-text {
      grid-column: 1 / -1;
    }
  }

  .deadline-box,
  .parents-box {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    margin-bottom: 1.4rem;
    background: var(--surface);
  }
  .deadline-box {
    border-left: 3px solid var(--gold);
  }
  .parents-box {
    border-left: 3px solid var(--accent-2);
    background: var(--bg-soft);
  }
  .deadline-box h2,
  .parents-box h2 {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .parents-box p {
    margin: 0;
  }
  .deadline-facts {
    margin: 0 0 0.8rem;
    display: grid;
    gap: 0.4rem;
  }
  .deadline-facts div {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 0.5rem;
  }
  .deadline-facts dt {
    color: var(--text-muted);
  }
  .deadline-facts dd {
    margin: 0;
  }
  .rolling-note {
    color: var(--text-muted);
  }
  .deadline-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-body :global(h2) {
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 7rem;
    margin-top: 1.8rem;
    padding-top: 1.2rem;
  }
  /* Layered sections */
  .sec-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .sec-toolbar span {
    margin-right: auto;
  }
  .post-body :global(details.sec) {
    border-top: 1px solid var(--border);
  }
  .post-body :global(details.sec:first-of-type) {
    border-top: 0;
  }
  .post-body :global(.sec-summary) {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 0;
  }
  .post-body :global(.sec-summary::-webkit-details-marker) {
    display: none;
  }
  .post-body :global(.sec-summary::before) {
    content: '';
