---
// Upcoming Deadlines (PRD 6.4, extended 14 Oct 2026): every dated item on the site, which means
// opportunity deadlines plus the key dates on any post. Upcoming ones grouped by month, soonest
// first; rolling opportunities; then every past date in a collapsed "Past dates" section, newest
// first, so students can still see what happened and when.
import Base from '../layouts/Base.astro';
import DeadlineBadge from '../components/DeadlineBadge.astro';
import Icon from '../components/Icon.astro';
import { getVisiblePosts, allDatedItems, gradeBandLabel, opportunityTypeLabel, type DatedItem } from '../lib/content';
import { categoryByKey } from '../config/site';
import { istTodayString, daysLeft, formatDateString } from '../lib/deadlines';

const today = istTodayString();
const all = await getVisiblePosts();
const items = allDatedItems(all);
const upcoming = items.filter((it) => daysLeft(it.date, today) >= 0);
const past = items.filter((it) => daysLeft(it.date, today) < 0).reverse();
const rolling = all.filter((p) => p.opportunity?.rolling);

const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
function byMonth(list: DatedItem[]): [string, DatedItem[]][] {
  const m = new Map<string, DatedItem[]>();
  for (const it of list) {
    const key = it.date.slice(0, 7);
    if (!m.has(key)) m.set(key, []);
    m.get(key)!.push(it);
  }
  return Array.from(m.entries());
}
const monthLabel = (key: string) => `${monthNames[+key.slice(5, 7) - 1]} ${key.slice(0, 4)}`;
const upcomingMonths = byMonth(upcoming);
const pastMonths = byMonth(past);
const kicker = (it: DatedItem) =>
  it.kind === 'deadline' && it.post.opportunity
    ? `${opportunityTypeLabel[it.post.opportunity.type] ?? 'Opportunity'} · ${it.post.gradeBands.map((g) => gradeBandLabel[g]).join(', ')}`
    : `${categoryByKey[it.post.category].shortName} · ${it.post.gradeBands.map((g) => gradeBandLabel[g]).join(', ')}`;
---

<Base title="Upcoming Deadlines" description="Every application deadline, test date and decision date on the site, soonest first, with past dates kept for reference.">
  <div class="container section">
    <h1>Upcoming Deadlines</h1>
    <p class="prose">
      Every dated item on the site: application deadlines, test dates, result days and decision dates, soonest first.
      A deadline means 11:59 PM India time on that day unless the note says otherwise. Always confirm on the official
      page before you plan.
    </p>
    <p class="jump">
      <a href="#upcoming">Upcoming ({upcoming.length})</a>
      {rolling.length > 0 && <a href="#rolling">Rolling ({rolling.length})</a>}
      <a href="#past">Past dates ({past.length})</a>
    </p>

    <h2 id="upcoming" class="part-heading">Upcoming</h2>
    {
      upcoming.length === 0 && (
        <p class="note">
          No upcoming dates right now. Check the <a href="/opportunities/">Internships &amp; Opportunities</a> page for rolling and new posts.
        </p>
      )
    }
    {
      upcomingMonths.map(([key, list]) => (
        <section class="month">
          <h3>{monthLabel(key)}</h3>
          <ul class="deadline-list">
            {list.map((it) => (
              <li class={`card deadline-item cat-${it.post.category}`}>
                <div class="deadline-date">
                  <span class="deadline-day">{+it.date.slice(8, 10)}</span>
                  <span class="deadline-mon">{formatDateString(it.date).split(' ')[1]}</span>
                </div>
                <div class="deadline-body">
                  <p class="deadline-kicker">{kicker(it)}</p>
                  <h4>
                    <a href={it.post.path}>{it.post.title}</a>
                  </h4>
                  <p class="deadline-what">{it.url ? <a href={it.url} target="_blank" rel="noopener">{it.label}</a> : it.label}</p>
                  <div class="deadline-meta">
                    <DeadlineBadge deadline={it.date} rolling={false} showDate />
                    {it.kind === 'deadline' && (
                      <a class="btn btn--outline btn--small" href={`${it.post.path}deadline.ics`} download>
                        <Icon name="calendar" size={16} /> Add to calendar
                      </a>
                    )}
                  </div>
                  {it.note && <p class="deadline-note">{it.note}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      rolling.length > 0 && (
        <section class="month" id="rolling">
          <h2 class="part-heading">No fixed deadline (rolling)</h2>
          <ul class="deadline-list">
            {rolling.map((p) => (
              <li class={`card deadline-item cat-${p.category}`}>
                <div class="deadline-date deadline-date--rolling">
                  <Icon name="opportunities" size={26} />
                </div>
                <div class="deadline-body">
                  <p class="deadline-kicker">{opportunityTypeLabel[p.opportunity!.type] ?? 'Opportunity'}</p>
                  <h4>
                    <a href={p.path}>{p.title}</a>
                  </h4>
                  <p class="deadline-what">{p.summary}</p>
                  <DeadlineBadge deadline={null} rolling={true} />
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <details class="past" id="past" open={upcoming.length === 0}>
      <summary>Past dates ({past.length})</summary>
      <p class="prose past-intro">
        Dates that have gone by, newest first. They show how each cycle runs, so you can plan the next one. A
        university usually keeps a similar calendar from year to year, but always check the new dates when they
        are announced.
      </p>
      {
        pastMonths.map(([key, list]) => (
          <section class="month month--past">
            <h3>{monthLabel(key)}</h3>
            <ul class="deadline-list">
              {list.map((it) => (
                <li class={`card deadline-item deadline-item--closed cat-${it.post.category}`}>
                  <div class="deadline-date">
                    <span class="deadline-day">{+it.date.slice(8, 10)}</span>
                    <span class="deadline-mon">{formatDateString(it.date).split(' ')[1]}</span>
                  </div>
                  <div class="deadline-body">
                    <p class="deadline-kicker">{kicker(it)}</p>
                    <h4>
                      <a href={it.post.path}>{it.post.title}</a>
                    </h4>
                    <p class="deadline-what">{it.url ? <a href={it.url} target="_blank" rel="noopener">{it.label}</a> : it.label}</p>
                    <DeadlineBadge deadline={it.date} rolling={false} showDate />
                    {it.note && <p class="deadline-note">{it.note}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      {past.length === 0 && <p class="empty">Nothing has passed yet.</p>}
    </details>

    <p class="deadline-footnote">
      Want to see these with filters? Go to <a href="/opportunities/?sort=deadline">Internships &amp; Opportunities</a> or
      <a href="/universities/?sort=deadline">Universities</a> and sort by deadline.
    </p>
  </div>
</Base>

<script>
  import '../scripts/deadlines';
</script>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin-bottom: 0.5rem;
  }
  .part-heading {
    margin-top: 1.6rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--gold);
  }
  .month h3 {
    font-size: 1.15rem;
    margin-top: 1.4rem;
    color: var(--text-muted);
  }
  .deadline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .deadline-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1rem;
    border-left: 5px solid var(--cat);
  }
  .deadline-item--closed {
    opacity: 0.82;
  }
  .deadline-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--tag-bg);
    color: var(--tag-text);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0;
    align-self: start;
    min-height: 64px;
  }
  .deadline-day {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
  }
  .deadline-mon {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .deadline-kicker {
    margin: 0 0 0.2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .deadline-body h4 {
    margin: 0 0 0.2rem;
    font-size: 1.1rem;
  }
  .deadline-body h4 a {
    color: var(--heading);
    text-decoration: none;
  }
  .deadline-body h4 a:hover {
    text-decoration: underline;
  }
  .deadline-what {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .deadline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }
  .deadline-note {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .past {
    margin-top: 2rem;
  }
  .past summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--heading);
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--gold);
  }
  .past-intro {
    margin-top: 0.8rem;
  }
  .deadline-footnote {
    margin-top: 2rem;
    color: var(--text-muted);
  }
  .empty {
    color: var(--text-muted);
  }
</style>
