---
import Base from '../layouts/Base.astro';
import { categories } from '../config/site';
---

<Base title="Page not found" description="We could not find that page." noindex>
  <div class="container section prose">
    <h1>We could not find that page</h1>
    <p>The link may be old, or the post may have been moved. Here is where to go instead:</p>
    <ul>
      <li><a href="/">Home page</a></li>
      <li><a href="/search/">Search the site</a></li>
      {categories.map((c) => <li><a href={c.path}>{c.name}</a></li>)}
    </ul>
    <p>If you think something is missing, <a href="/about/">write to me</a>.</p>
  </div>
</Base>
